# Goal: push advances a remote branch to the local commit.
D DATE "Date: \w{3} \w{3} \d{2} \d{2}:\d{2}:\d{2} \d{4} [-+]\d{4}"
C REMOTE
> init
<<<
C LOCAL
> init
<<<
> add-remote origin ../REMOTE/.gitlite
<<<
+ f.txt wug.txt
> add f.txt
<<<
> commit "local file"
<<<
> log
===
commit ([a-f0-9]{40})
${DATE}
local file

(?:.|\n)*
<<<*
D LOCAL_HEAD "${1}"
> push origin master
<<<
C REMOTE
> log
===
commit ${LOCAL_HEAD}
${DATE}
local file

(?:.|\n)*
<<<*
> checkout -- f.txt
<<<
= f.txt wug.txt
