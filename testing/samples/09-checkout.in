# Goal: checkout switches branches and restores a tracked file.
> init
<<<
+ f.txt wug.txt
> add f.txt
<<<
> commit "first"
<<<
> branch old
<<<
+ f.txt notwug.txt
> add f.txt
<<<
> commit "second"
<<<
> checkout old
<<<
= f.txt wug.txt
> checkout master
<<<
= f.txt notwug.txt
+ f.txt wug2.txt
> checkout -- f.txt
<<<
= f.txt notwug.txt
